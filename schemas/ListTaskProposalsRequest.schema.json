    },
    "offset": {
      "default": 0,
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProposalStatus"
        },
        {
          "type": "null"
        }
