{
  "$defs": {
    "DestinationRef": {
      "additionalProperties": false,
      "description": "Referência neutra a um destino externo de tarefa.\n\nNem todos os campos se aplicam a todos os providers (ex.: GitHub não possui\n``issue_type``; ClickUp usa uma hierarquia diferente).",
      "properties": {
        "connection_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection Id"
        },
        "default_priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskPriority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "external_container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Container Id"
        },
        "external_project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Project Id"
        },
        "external_workspace_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Workspace Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "issue_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Type"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider"
      ],
      "title": "DestinationRef",
      "type": "object"
    },
    "RoutingRule": {
      "additionalProperties": false,
      "description": "Regra do workspace que associa condições de uma tarefa a um destino.\n\nCada condição preenchida deve casar com a tarefa. Quanto mais condições,\nmais específica a regra (e maior a prioridade na resolução).",
      "properties": {
        "destination": {
          "$ref": "#/$defs/DestinationRef"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskPriority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "destination"
      ],
      "title": "RoutingRule",
      "type": "object"
    },
    "SourceKind": {
      "description": "Natureza da origem de uma informação.",
      "enum": [
        "FILE",
        "TRANSCRIPT",
        "TIMESTAMP",
        "LOG_LINE",
        "URL",
        "ISSUE",
        "COMMIT",
        "SCREENSHOT",
        "OTHER"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "TaskPriority": {
      "description": "Prioridades neutras utilizadas pelo ecossistema.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "TaskPriority",
      "type": "string"
    },
    "TaskType": {
      "description": "Categorias neutras de trabalho reconhecidas pelo Task Engine.",
      "enum": [
        "BUG",
        "TASK",
        "FEATURE",
        "IMPROVEMENT",
        "TECH_DEBT",
        "QUESTION",
        "INVESTIGATION",
        "DOCUMENTATION"
      ],
      "title": "TaskType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Conjunto de regras de roteamento e destino padrão de um workspace.\n\nHierarquia de resolução (da mais para a menos prioritária):\n\n1. destino escolhido manualmente na aprovação;\n2. regra mais específica que casar;\n3. destino padrão do workspace;\n4. nenhum destino (não executar ação externa).\n\nEm empate de especificidade vence a regra declarada primeiro em ``rules``.",
  "properties": {
    "default_destination": {
      "anyOf": [
        {
          "$ref": "#/$defs/DestinationRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RoutingRule"
      },
      "title": "Rules",
      "type": "array"
    }
  },
  "title": "RoutingPolicy",
  "type": "object"
}
